# =============================================================================
# FLY FLIGHT TICKETING PLATFORM - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env and configure values for your target deployment.
# NEVER commit .env or actual production secrets to version control.

APP_NAME="FLY Aviation API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Dhaka
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Logging Configuration
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (POSTGRESQL PRIMARY / SQLITE LOCAL FALLBACK)
# -----------------------------------------------------------------------------
# For local zero-dependency testing, set DB_CONNECTION=sqlite
# For staging / production, set DB_CONNECTION=pgsql with your credentials
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=fly_ticketing
DB_USERNAME=fly_app_user
DB_PASSWORD=replace_with_secure_database_password
DB_SSLMODE=prefer

# -----------------------------------------------------------------------------
# REDIS CACHE & ASYNC QUEUE CONFIGURATION
# -----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

# -----------------------------------------------------------------------------
# CORS & SECURITY HEADERS
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5000,http://127.0.0.1:5000"
SANCTUM_STATEFUL_DOMAINS="localhost,localhost:3000,localhost:5000,127.0.0.1"

# -----------------------------------------------------------------------------
# MAIL & NOTIFICATION CHANNELS (LOG IN LOCAL/DEV)
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@flyaviation.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# FLIGHT INVENTORY PROVIDER SECRETS (MANDATORY TO ENABLE SANDBOX/LIVE GDS)
# -----------------------------------------------------------------------------
# Amadeus Self-Service / Enterprise REST API credentials.
# Obtain from https://developers.amadeus.com/my-apps
# When absent, the system safely falls back to the Mock provider and adapter skeleton.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENVIRONMENT=test
AMADEUS_BASE_URL=https://test.api.amadeus.com
AMADEUS_TIMEOUT=15.0
