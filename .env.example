# ==============================================================================
# FLY FLIGHT TICKETING PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure for your local/production environment.
# DO NOT COMMIT SENSITIVE PRODUCTION SECRETS OR LIVE API KEYS TO GIT.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
FLASK_APP=app.py
FLASK_ENV=development
DEBUG=True
PORT=5000
HOST=0.0.0.0
SECRET_KEY=replace_with_a_secure_random_64_char_hex_secret_in_production
APP_BASE_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Development SQLite Path:
DATABASE_PATH=database/flight_booking.db
# Production PostgreSQL Connection URL (format: postgresql://user:pass@host:5432/dbname):
# DATABASE_URL=postgresql://fly_user:fly_password@localhost:5432/fly_db

# ------------------------------------------------------------------------------
# 3. CACHE & BACKGROUND QUEUE (REDIS)
# ------------------------------------------------------------------------------
REDIS_ENABLED=False
REDIS_URL=redis://localhost:6379/0
SEARCH_CACHE_TTL_SECONDS=300

# ------------------------------------------------------------------------------
# 4. FLIGHT SUPPLIER / GDS CONFIGURATION (RULE #5 COMPLIANT - PLACEHOLDERS ONLY)
# Options: DEMO_LOCAL (Active Default) | AMADEUS_GDS | SABRE_GDS | DUFFEL_NDC
# ------------------------------------------------------------------------------
FLIGHT_PROVIDER_ACTIVE=DEMO_LOCAL
FLIGHT_PROVIDER_SANDBOX_MODE=True

# Amadeus GDS Credentials (Required only when FLIGHT_PROVIDER_ACTIVE=AMADEUS_GDS)
AMADEUS_CLIENT_ID=your_amadeus_api_key_placeholder
AMADEUS_CLIENT_SECRET=your_amadeus_api_secret_placeholder
AMADEUS_OFFICE_ID=DACBG28AA

# Duffel NDC Credentials (Required only when FLIGHT_PROVIDER_ACTIVE=DUFFEL_NDC)
DUFFEL_ACCESS_TOKEN=duffel_test_placeholder_token

# Local Consolidator API (e.g. Flyhub / Sabre Bangladesh)
CONSOLIDATOR_API_ENDPOINT=https://api.consolidator.placeholder/v1
CONSOLIDATOR_API_KEY=your_consolidator_api_key_placeholder
CONSOLIDATOR_AGENT_ID=your_agent_id_placeholder

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAY CONFIGURATION (RULE #5 COMPLIANT - PLACEHOLDERS ONLY)
# Options: SIMULATED (Active Default) | SSLCOMMERZ | BKASH | STRIPE
# ------------------------------------------------------------------------------
PAYMENT_GATEWAY_ACTIVE=SIMULATED
PAYMENT_GATEWAY_SANDBOX=True

# SSLCommerz Credentials (for Bangladesh BDT Payments)
SSLCOMMERZ_STORE_ID=your_store_id_placeholder
SSLCOMMERZ_STORE_PASS=your_store_password_placeholder
SSLCOMMERZ_IS_SANDBOX=True

# bKash Merchant API Credentials
BKASH_APP_KEY=your_bkash_app_key_placeholder
BKASH_APP_SECRET=your_bkash_app_secret_placeholder
BKASH_USERNAME=your_bkash_username_placeholder
BKASH_PASSWORD=your_bkash_password_placeholder

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL NOTIFICATIONS (EMAIL / SMS)
# ------------------------------------------------------------------------------
NOTIFICATIONS_ENABLED=False
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no-reply@fly-booking.com
SMTP_PASSWORD=your_app_password_placeholder
SMTP_FROM_NAME="FLY Customer Care"

# SMS Gateway (e.g., Twilio, Infobip, or Greenweb BD)
SMS_PROVIDER=NONE
SMS_API_KEY=your_sms_api_key_placeholder
SMS_SENDER_ID=FLYBD

# ------------------------------------------------------------------------------
# 7. SECURITY & SESSION POLICIES
# ------------------------------------------------------------------------------
SESSION_TTL_DAYS=7
SEAT_LOCK_MINUTES=10
SEAT_EXTENSION_MINUTES=2
LOCK_SWEEP_INTERVAL_SECONDS=30
MAX_SEATS_PER_BOOKING=9
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
FLY_SECRET_KEY=replace_with_a_secure_random_64_char_hex_secret_in_production
